{
  "name": "@jackmorganxyz/marque",
  "version": "2.0.0",
  "description": "Sign JSON messages and verify their signing addresses. Identity and trust stay with the caller.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Jack Morgan <contact@jackmorgan.xyz>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackmorganxyz/marque.git"
  },
  "bugs": "https://github.com/jackmorganxyz/marque/issues",
  "homepage": "https://github.com/jackmorganxyz/marque#readme",
  "keywords": [
    "agent",
    "signing",
    "verify",
    "eip-191",
    "secp256k1"
  ],
  "sideEffects": false,
  "main": "./dist/marque.js",
  "types": "./dist/marque.d.ts",
  "exports": {
    ".": {
      "types": "./dist/marque.d.ts",
      "import": "./dist/marque.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && rm -f dist/marque.test.*",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test marque.test.ts site/demo.test.mjs examples/keygen.test.mjs",
    "test:redis": "npm run build && node --test examples/redis-receiver.test.mjs",
    "build:site": "node site/build.mjs",
    "example": "npm run build && node examples/round-trip.mjs",
    "check": "npm run build && npm test && node examples/round-trip.mjs && npm run build:site",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "redis": "~5.11.0",
    "tsx": "^4",
    "typescript": "^5"
  }
}
